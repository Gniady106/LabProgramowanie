@model ContactModel


@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Dodaj kontakt</h2>
<div>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input class="form-control" type="text" asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="LastName"></label>
            <input class="form-control" type="text" asp-for="LastName" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email"></label>
            <input class="form-control" type="email" asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="PhoneNum"></label>
            <input class="form-control" type="text" asp-for="PhoneNum" />
            <span asp-validation-for="PhoneNum" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="BirthDate"></label>
            <input class="form-control" type="date" asp-for="BirthDate" />
            <span asp-validation-for="BirthDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Category"></label>
            <select class="form-control"  asp-for="Category" asp-items="@Html.GetEnumSelectList<Category>()">
                
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Dodaj</button>
        <a asp-action="Index"  asp-controller="Contact" class="btn btn-secondary">Anuluj</a>
    </form>
</div>