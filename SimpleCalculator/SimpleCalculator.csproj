<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Views\Calculate\**" />
      <Compile Remove="Controllers\CalculatorController.cs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Views\Calculate\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="Views\Calculate\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Views\Calculate\**" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Views\Calculate\Index.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Birth\BirthForm.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Birth\BirthResult.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Calculator\Form.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Calculator\Result.cshtml" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    </ItemGroup>

</Project>
